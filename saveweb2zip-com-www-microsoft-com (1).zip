
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Microsoft Defender | Security Center</title>
<meta name="description" content="A Microsoft Defender-inspired antivirus and security dashboard demo.">

<style>
:root {
    --blue: #0067b8;
    --blue-dark: #004578;
    --green: #107c10;
    --bg: #f5f7fa;
    --white: #ffffff;
    --text: #242424;
    --muted: #626a73;
    --border: #e1e5e9;
    --shadow: 0 4px 18px rgba(0,0,0,.06);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Segoe UI", Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    font: inherit;
    cursor: pointer;
}

.container {
    width: min(1160px, 92%);
    margin: auto;
}

/* Header */

header {
    background: white;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 10;
}

.navbar {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 20px;
    font-weight: 650;
}

.shield {
    width: 37px;
    height: 42px;
    display: grid;
    place-items: center;
    background: var(--blue);
    color: white;
    clip-path: polygon(50% 0, 100% 17%, 94% 67%, 50% 100%, 6% 67%, 0 17%);
    font-size: 20px;
}

nav {
    display: flex;
    align-items: center;
    gap: 26px;
}

nav a {
    color: #454545;
    font-size: 14px;
}

nav a:hover {
    color: var(--blue);
}

.menu-btn {
    display: none;
    background: none;
    border: none;
    font-size: 25px;
}

/* Hero */

.hero {
    padding: 76px 0 65px;
    background: linear-gradient(120deg, #eaf4ff, #f7fbff 60%, #edf8f0);
}

.hero-grid {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    align-items: center;
    gap: 55px;
}

.eyebrow {
    color: var(--blue);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 17px;
}

h1, h2, h3 {
    line-height: 1.25;
}

.hero h1 {
    font-size: clamp(36px, 5vw, 58px);
    letter-spacing: -1.6px;
    margin-bottom: 22px;
}

.hero p {
    max-width: 560px;
    color: var(--muted);
    font-size: 17px;
    margin-bottom: 27px;
}

.actions {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 12px 22px;
    border: 1px solid var(--blue);
    background: var(--blue);
    color: white;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    transition: .2s;
}

.btn:hover {
    background: var(--blue-dark);
}

.btn.secondary {
    background: white;
    color: var(--blue);
}

.btn.secondary:hover {
    background: #edf5fc;
}

.hero-visual {
    background: white;
    padding: 38px 25px;
    border: 1px solid #e0eaf3;
    border-radius: 12px;
    box-shadow: var(--shadow);
    text-align: center;
}

.big-shield {
    width: 112px;
    height: 128px;
    margin: 0 auto 18px;
    display: grid;
    place-items: center;
    color: white;
    font-size: 54px;
    background: linear-gradient(145deg, #1389e8, #005a9e);
    clip-path: polygon(50% 0, 100% 17%, 93% 67%, 50% 100%, 7% 67%, 0 17%);
}

.hero-visual h3 {
    font-size: 22px;
    margin-bottom: 8px;
}

.hero-visual p {
    font-size: 14px;
    margin: 0 auto 15px;
}

.status {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    color: var(--green);
    font-size: 13px;
    font-weight: 650;
}

.dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #16a34a;
}

/* Common sections */

section {
    padding: 70px 0;
    scroll-margin-top: 90px;
}

.section-heading {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 35px;
}

.section-heading h2 {
    font-size: clamp(29px, 4vw, 39px);
    margin-bottom: 13px;
}

.section-heading p {
    color: var(--muted);
}

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 25px;
    box-shadow: 0 2px 9px rgba(0,0,0,.025);
}

.card-icon {
    width: 49px;
    height: 49px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: #eaf4ff;
    font-size: 25px;
    margin-bottom: 19px;
}

.card h3 {
    font-size: 19px;
    margin-bottom: 10px;
}

.card p {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 18px;
}

.card-link {
    color: var(--blue);
    font-size: 14px;
    font-weight: 650;
}

.card-link:hover {
    text-decoration: underline;
}

/* Scanner */

.scanner-section {
    background: #eaf4ff;
}

.scanner {
    max-width: 760px;
    margin: auto;
    background: white;
    border: 1px solid #dce8f2;
    border-radius: 10px;
    padding: 35px;
    box-shadow: var(--shadow);
}

.scanner-top {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 24px;
}

.scanner-top .card-icon {
    flex-shrink: 0;
    margin: 0;
}

.scanner-top h3 {
    margin-bottom: 5px;
}

.scanner-top p {
    color: var(--muted);
    font-size: 14px;
}

.scan-details {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    margin: 22px 0 10px;
    font-size: 13px;
    color: var(--muted);
}

.progress-track {
    height: 9px;
    background: #e7ebef;
    border-radius: 10px;
    overflow: hidden;
}

.progress-bar {
    width: 0;
    height: 100%;
    background: var(--blue);
    border-radius: 10px;
    transition: width .25s;
}

.scan-result {
    min-height: 27px;
    margin-top: 17px;
    font-size: 14px;
}

.scan-note {
    color: var(--muted);
    font-size: 12px;
    margin-top: 12px;
}

/* Security information */

.security-list {
    max-width: 850px;
    margin: auto;
}

.security-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    background: white;
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 20px 24px;
    margin-bottom: 13px;
}

.security-name {
    display: flex;
    align-items: center;
    gap: 15px;
}

.security-name h3 {
    font-size: 16px;
}

.security-name p {
    font-size: 13px;
    color: var(--muted);
}

.ok {
    color: var(--green);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
}

/* About */

.about {
    background: white;
}

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 55px;
}

.about-art {
    min-height: 290px;
    background: linear-gradient(135deg, #e7f2ff, #e9f7ec);
    border-radius: 12px;
    display: grid;
    place-items: center;
}

.about-art .big-shield {
    width: 135px;
    height: 154px;
}

.about-copy h2 {
    font-size: 35px;
    margin-bottom: 18px;
}

.about-copy p {
    color: var(--muted);
    margin-bottom: 17px;
}

/* Footer */

footer {
    background: #172b3a;
    color: white;
    padding: 30px 0;
}

.footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
}

footer p {
    font-size: 13px;
    color: #d4dce3;
}

footer a {
    color: #dceeff;
    font-size: 13px;
}

/* Mobile */

@media (max-width: 800px) {
    .menu-btn {
        display: block;
    }

    nav {
        display: none;
        position: absolute;
        left: 0;
        right: 0;
        top: 72px;
        background: white;
        border-bottom: 1px solid var(--border);
        padding: 22px 5%;
        flex-direction: column;
        align-items: flex-start;
        gap: 19px;
    }

    nav.open {
        display: flex;
    }

    .hero-grid,
    .about-grid {
        grid-template-columns: 1fr;
        gap: 35px;
    }

    .dashboard-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .hero {
        padding: 50px 0;
    }
}

@media (max-width: 540px) {
    section {
        padding: 50px 0;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .scanner {
        padding: 22px;
    }

    .scanner-top {
        align-items: flex-start;
    }

    .security-row {
        padding: 17px 14px;
    }

    .security-name {
        gap: 10px;
    }

    .security-name p {
        font-size: 12px;
    }

    .ok {
        font-size: 11px;
    }
}
</style>
</head>

<body>

<header>
    <div class="container navbar">
        <a href="#home" class="brand">
            <span class="shield">?</span>
            <span>Defender Security</span>
        </a>

        <button class="menu-btn" id="menuBtn"
                aria-label="Open navigation"
                aria-expanded="false">?</button>

        <nav id="navigation">
            <a href="#home">Home</a>
            <a href="#features">Features</a>
            <a href="#scan">Security Scan</a>
            <a href="#protection">Protection</a>
            <a href="#about">About</a>
        </nav>
    </div>
</header>

<main>

    <!-- Hero section -->
    <section class="hero" id="home">
        <div class="container hero-grid">
            <div>
                <div class="eyebrow">Your digital safety matters</div>
                <h1>Security that helps you stay one step ahead.</h1>
                <p>
                    Explore a modern security dashboard concept designed
                    around device safety, online privacy, and digital
                    protection.
                </p>

                <div class="actions">
                    <a href="#scan" class="btn">Explore Scan Demo ?</a>
                    <a href="#features" class="btn secondary">Learn More</a>
                </div>
            </div>

            <div class="hero-visual">
                <div class="big-shield">?</div>
                <h3>Security Dashboard</h3>
                <p>This is a website demonstration, not a live device scan.</p>
                <span class="status">
                    <span class="dot"></span>
                    Demo interface ready
                </span>
            </div>
        </div>
    </section>

    <!-- Features -->
    <section id="features">
        <div class="container">
            <div class="section-heading">
                <div class="eyebrow">Security Features</div>
                <h2>Protection for your digital life</h2>
                <p>
                    Learn about essential security concepts through
                    this interactive antivirus website demo.
                </p>
            </div>

            <div class="dashboard-grid">
                <article class="card">
                    <div class="card-icon">???</div>
                    <h3>Threat Protection</h3>
                    <p>
                        Antivirus software can help detect, block,
                        and remove malicious software.
                    </p>
                    <a href="#protection" class="card-link">Learn more ?</a>
                </article>

                <article class="card">
                    <div class="card-icon">??</div>
                    <h3>Web Protection</h3>
                    <p>
                        Learn how safe browsing habits help you avoid
                        suspicious websites and phishing links.
                    </p>
                    <a href="#protection" class="card-link">Learn more ?</a>
                </article>

                <article class="card">
                    <div class="card-icon">??</div>
                    <h3>Privacy & Security</h3>
                    <p>
                        Use strong passwords, secure your accounts,
                        and keep your software updated.
                    </p>
                    <a href="#protection" class="card-link">Learn more ?</a>
                </article>
            </div>
        </div>
    </section>

    <!-- Scan demo -->
    <section class="scanner-section" id="scan">
        <div class="container">
            <div class="section-heading">
                <div class="eyebrow">Interactive Demonstration</div>
                <h2>Security Scan Demo</h2>
                <p>
                    Try the simulated scan to see how an antivirus
                    dashboard might display its progress.
                </p>
            </div>

            <div class="scanner">
                <div class="scanner-top">
                    <div class="card-icon">??</div>
                    <div>
                        <h3 id="scanTitle">Quick Scan Simulation</h3>
                        <p id="scanDescription">
                            This demo animates a progress bar only.
                            It does not inspect your device.
                        </p>
                    </div>
                </div>

                <div class="actions">
                    <button class="btn" id="scanBtn" type="button">
                        Start Demo Scan
                    </button>
                    <button class="btn secondary" id="resetBtn" type="button">
                        Reset
                    </button>
                </div>

                <div class="scan-details">
                    <span id="scanStatus">Ready to demonstrate</span>
                    <span id="scanPercent">0%</span>
                </div>

                <div class="progress-track"
                     role="progressbar"
                     aria-label="Simulated scan progress"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="0"
                     id="progressTrack">
                    <div class="progress-bar" id="progressBar"></div>
                </div>

                <div class="scan-result" id="scanResult" role="status">
                </div>

                <p class="scan-note">
                    Important: This is only a visual simulation. No files,
                    applications, or system settings are scanned.
                </p>
            </div>
        </div>
    </section>

    <!-- Protection status -->
    <section id="protection">
        <div class="container">
            <div class="section-heading">
                <div class="eyebrow">Stay Protected</div>
                <h2>Essential security practices</h2>
                <p>
                    These are educational reminders, not verified
                    protection statuses for your computer.
                </p>
            </div>

            <div class="security-list">
                <div class="security-row">
                    <div class="security-name">
                        <div class="card-icon">??</div>
                        <div>
                            <h3>System Updates</h3>
                            <p>Install operating system security updates.</p>
                        </div>
                    </div>
                    <span class="ok">Recommended</span>
                </div>

                <div class="security-row">
                    <div class="security-name">
                        <div class="card-icon">??</div>
                        <div>
                            <h3>Password Safety</h3>
                            <p>Use unique passwords and multifactor authentication.</p>
                        </div>
                    </div>
                    <span class="ok">Recommended</span>
                </div>

                <div class="security-row">
                    <div class="security-name">
                        <div class="card-icon">???</div>
                        <div>
                            <h3>Antivirus Software</h3>
                            <p>Use a trusted, up-to-date security product.</p>
                        </div>
                    </div>
                    <span class="ok">Recommended</span>
                </div>

                <div class="security-row">
                    <div class="security-name">
                        <div class="card-icon">??</div>
                        <div>
                            <h3>Data Backups</h3>
                            <p>Back up important files regularly.</p>
                        </div>
                    </div>
                    <span class="ok">Recommended</span>
                </div>
            </div>
        </div>
    </section>

    <!-- About -->
    <section class="about" id="about">
        <div class="container about-grid">
            <div class="about-art">
                <div class="big-shield">?</div>
            </div>

            <div class="about-copy">
                <div class="eyebrow">About This Project</div>
                <h2>A simple security website built with web technologies.</h2>
                <p>
                    This single-page project demonstrates a security-themed
                    interface built using HTML, CSS, and JavaScript.
                </p>
                <p>
                    It is not an official Microsoft product and does not
                    connect to Microsoft Defender, Windows Security, or
                    any antivirus engine.
                </p>
                <a href="#home" class="btn">Back to Top ?</a>
            </div>
        </div>
    </section>

</main>

<footer>
    <div class="container footer-inner">
        <a href="#home" class="brand">
            <span class="shield">?</span>
            <span>Defender Security Demo</span>
        </a>

        <p>© <span id="year"></span> Educational Website Demo</p>
        <a href="#about">About this project</a>
    </div>
</footer>

<script>
    // Mobile navigation
    const menuBtn = document.getElementById("menuBtn");
    const navigation = document.getElementById("navigation");

    menuBtn.addEventListener("click", function () {
        const open = navigation.classList.toggle("open");
        menuBtn.setAttribute("aria-expanded", String(open));
        menuBtn.setAttribute(
            "aria-label",
            open ? "Close navigation" : "Open navigation"
        );
        menuBtn.textContent = open ? "?" : "?";
    });

    navigation.querySelectorAll("a").forEach(function (link) {
        link.addEventListener("click", function () {
            navigation.classList.remove("open");
            menuBtn.setAttribute("aria-expanded", "false");
            menuBtn.setAttribute("aria-label", "Open navigation");
            menuBtn.textContent = "?";
        });
    });

    // Update footer year
    document.getElementById("year").textContent =
        new Date().getFullYear();

    // Simulated scan: no access to files or operating system
    const scanBtn = document.getElementById("scanBtn");
    const resetBtn = document.getElementById("resetBtn");
    const scanBar = document.getElementById("progressBar");
    const scanPercent = document.getElementById("scanPercent");
    const scanStatus = document.getElementById("scanStatus");
    const scanResult = document.getElementById("scanResult");
    const scanTitle = document.getElementById("scanTitle");
    const scanDescription = document.getElementById("scanDescription");
    const progressTrack = document.getElementById("progressTrack");

    let progress = 0;
    let timer = null;

    function resetScan() {
        if (timer !== null) {
            clearInterval(timer);
            timer = null;
        }

        progress = 0;
        scanBar.style.width = "0%";
        scanPercent.textContent = "0%";
        scanStatus.textContent = "Ready to demonstrate";
        scanResult.textContent = "";
        scanTitle.textContent = "Quick Scan Simulation";
        scanDescription.textContent =
            "This demo animates a progress bar only. It does not inspect your device.";
        scanBtn.disabled = false;
        scanBtn.textContent = "Start Demo Scan";
        progressTrack.setAttribute("aria-valuenow", "0");
    }

    scanBtn.addEventListener("click", function () {
        if (timer !== null) return;

        progress = 0;
        scanResult.textContent = "";
        scanStatus.textContent = "Running visual simulation...";
        scanTitle.textContent = "Simulated Scan in Progress";
        scanDescription.textContent =
            "Displaying sample progress. No real files are being scanned.";
        scanBtn.disabled = true;
        scanBtn.textContent = "Demo Running...";

        timer = setInterval(function () {
            progress = Math.min(progress + Math.floor(Math.random() * 9) + 4, 100);

            scanBar.style.width = progress + "%";
            scanPercent.textContent = progress + "%";
            progressTrack.setAttribute("aria-valuenow", String(progress));

            if (progress >= 100) {
                clearInterval(timer);
                timer = null;

                scanStatus.textContent = "Demo complete";
                scanResult.textContent =
                    "Simulation finished. No real security checks were performed.";
                scanTitle.textContent = "Demo Scan Completed";
                scanDescription.textContent =
                    "This result is not evidence that your computer is safe.";
                scanBtn.disabled = false;
                scanBtn.textContent = "Run Again";
            }
        }, 250);
    });

    resetBtn.addEventListener("click", resetScan);
</script>

</body>
</html>
